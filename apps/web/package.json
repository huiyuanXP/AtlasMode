{
  "name": "@codemap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemap/core": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "vite": "7.3.6",
    "@vitejs/plugin-react": "5.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
