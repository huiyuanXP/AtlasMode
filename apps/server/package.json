{
  "name": "@codemap/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@codemap/core": "0.0.0",
    "@codemap/indexer": "0.0.0",
    "@codemap/service": "0.0.0",
    "@codemap/storage": "0.0.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  }
}
