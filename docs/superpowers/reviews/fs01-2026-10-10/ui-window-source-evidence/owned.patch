+    await expect(card).toBeVisible();
+    const before = await sourceReceipt(projectPath);
+    return {
+      root,
+      projectPath,
+      marker,
+      server,
+      api,
+      project,
+      summary,
+      selected,
+      detail,
+      card,
+      before,
+      external,
+      errors,
+      dispose: async () => {
+        try {
+          await server.stop();
+        } finally {
+          await rm(root, { recursive: true, force: true });
+          await writeFile(
+            info.outputPath("cleanup.json"),
