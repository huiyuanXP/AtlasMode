+    }
+    return substitute(exports[pattern]);
+  }
+  function outcomes(
+    value: unknown,
+    mode: "import" | "require",
+    budget: { remaining: number },
+    depth = 0,
+  ): Set<Outcome> {
+    if (--budget.remaining < 0 || depth > 16) return new Set([INVALID]);
+    if (typeof value === "string") return new Set([value]);
+    if (value === NO_MATCH) return new Set([NO_MATCH]);
