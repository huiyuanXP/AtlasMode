+const capture = (inputs: Record<string, unknown>): SourceFile[] =>
+  Object.entries(inputs).map(([path, value]) => ({
+    path,
+    bytes: Buffer.from(
+      typeof value === "string" ? value : JSON.stringify(value),
+    ),
+  }));
