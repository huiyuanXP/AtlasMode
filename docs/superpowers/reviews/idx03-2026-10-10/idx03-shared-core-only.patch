+      reject("Scope category totals must equal sourceScopes");
+    for (const [collection, observed] of [
+      ["roots", counts.observedRoots],
+      ["projects", counts.observedProjects],
+      ["references", counts.observedReferences],
+      ["scopes", counts.sourceScopes],
+    ] as const) {
+      const returned = graph[collection].length;
