+    references: z
+      .array(
+        z
+          .strictObject({
+            sourceConfigPath: configurationGraphPath,
+            referencePathPreview: z.string().max(256),
+            targetConfigPath: configurationGraphPath.optional(),
+            status: z.enum([
+              "resolved",
+              "invalid",
+              "unavailable",
+              "cycle",
+              "budget",
+            ]),
+            reason: z.string().max(512).optional(),
+            referencePathTruncated: z.boolean(),
