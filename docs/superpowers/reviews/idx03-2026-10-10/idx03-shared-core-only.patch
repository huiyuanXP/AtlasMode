+      "unconfigured",
+      "ambiguous",
+      "invalid",
+    ] as const)
+      if (
+        graph.scopes.filter((scope) => scope.status === category).length >
+        counts[category]
+      )
+        reject(`Returned ${category} scopes exceed total category count`);
+  });
