+}
+export function assertOwnedPidAbsent(pid: number | undefined) {
+  if (!pid) throw new Error("owned child PID missing");
+  try {
+    process.kill(pid, 0);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ESRCH") return;
+    throw error;
+  }
+  throw new Error(`owned child still alive: ${pid}`);
