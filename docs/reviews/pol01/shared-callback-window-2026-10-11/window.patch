+    rows: (value: DirectoryPolicy[]) => {
+      rows = value;
+    },
+    plans: (value: PlanDetail[]) => {
+      details = value;
+    },
+    strong: (value: Response) => {
+      strong = value;
+    },
+    fail: (suffix: string) => {
+      failPath = suffix;
+    },
+    hold: (suffix: string) => {
+      const gate = deferred<Response>();
+      const own = { suffix, gate, entered: false };
+      hold = own;
+      return { ...gate, entered: () => own.entered };
+    },
+  };
