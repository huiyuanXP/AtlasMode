+});
+function fixture() {
+  const calls: string[] = [];
+  let rows = [policy()],
+    details = [plan(3)],
+    strong = notApproved(),
+    failPath = "";
+  let hold:
+    | {
+        suffix: string;
+        gate: ReturnType<typeof deferred<Response>>;
+        entered: boolean;
+      }
+    | undefined;
+  const api = new HttpApi((async (input, init) => {
+    const path = String(input);
+    calls.push(`${init?.method ?? "GET"} ${path}`);
