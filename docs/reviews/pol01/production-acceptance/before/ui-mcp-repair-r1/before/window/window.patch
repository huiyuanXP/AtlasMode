+          await onReadAccepted({
+            projectId: s.projectId,
+            epoch,
+            snapshot,
+            policies: policies.policies,
+          });
+        } catch (e) {
+          throw new StructureClientError(
+            "WORKSPACE_SYNC_REQUIRED",
+            e instanceof Error ? e.message : "Workspace refresh required.",
