+            "STRUCTURE_CAPTURE_INVALID",
+            "Structure response has no valid revision/digest capture.",
+          );
+        if (snapshot.projectId !== s.projectId)
+          throw new StructureClientError(
+            "PROJECT_MISMATCH",
+            "Structure belongs to another project.",
